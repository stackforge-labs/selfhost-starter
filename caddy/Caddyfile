# Plain HTTP on :80 - TLS is terminated by Cloudflare when using a Tunnel.
# Add one block per app. Subdomain routing example:
{
	auto_https off
}

http://whoami.{$DOMAIN:localhost} {
	reverse_proxy whoami:80
}

